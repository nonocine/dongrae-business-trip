NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# service_role 키 — RLS 우회. 서버 전용(lib/supabaseAdmin.ts). 절대 NEXT_PUBLIC_ 금지.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# (deprecated, 미사용) SEC-3b 에서 공유비번 관리자 로그인이 제거되어 코드에서
#   더 이상 참조하지 않습니다. 관리자 권한은 구글 관장·master 로 일원화되었습니다.
ADMIN_PASSWORD=changeme
# 세션 쿠키 HMAC 서명 키(SEC-3a) — 필수. 없으면 서버가 기동 시점에 throw 합니다.
#   생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
# 급여명세서 발송(급여 3차) — Gmail SMTP. 미설정 시 발송 버튼에 "설정 필요" 안내.
#   앱 비밀번호: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호(16자리) 발급.
GMAIL_SENDER=master@onnainna.kr
GMAIL_APP_PASSWORD=YOUR_16_CHAR_APP_PASSWORD
